function startStory(){if(S.storyStarted||S.era!=='2009')return;S.storyStarted=true;runBeat(0)}
function who(name){name=String(name||'').trim();if(name===NM('w'))return 'w';if(name===NM('j'))return 'j';if(name==='시스템'||name==='系统')return 'sys';return 'w'}
function parseSay(t){return lines(t).map(l=>{const m=l.match(/^([^:：]{1,10})\s*[:：]\s*(.*)$/);return m?{name:m[1].trim(),text:m[2]}:{name:NM('w'),text:l}})}
function ruleReply(input,rules,def,defName){const q=String(input).toLowerCase().replace(/\s/g,'');let out=null;
 for(const l of lines(rules)){const [k,...rest]=l.split('=>');if(!rest.length)continue;const keys=k.split(',').map(x=>x.trim().toLowerCase().replace(/\s/g,'')).filter(Boolean);if(keys.some(x=>q.includes(x))){out=rest.join('=>');break}}
 if(out==null)out=def||'';return out.split(/\s\/\s|\n/).map(x=>x.trim()).filter(Boolean).map(x=>{const m=x.match(/^([^:：]{1,10})\s*[:：]\s*(.*)$/);return m?{name:m[1].trim(),text:m[2]}:{name:defName,text:x}})}
function needOk(input,need){if(!String(need||'').trim())return true;const q=String(input).toLowerCase().replace(/\s/g,'');return need.split(',').map(x=>x.trim().toLowerCase().replace(/\s/g,'')).filter(Boolean).some(x=>q.includes(x))}
async function speak(ch,msgs){const g=S.gen;for(const m of msgs){if(S.ended||S.gen!==g)return;
 if(m.name==='시스템'||m.name==='系统'){S.chats[ch].push({sys:true,text:m.text});ch==='memo'?paintMemo():paintChat(ch);await wait(1500);continue}
 if(ch==='memo'){S.busy.memo=true;const o={text:'',me:false};S.chats.memo.push(o);for(const c of m.text){if(S.gen!==g)return;o.text+=c;paintMemo();await wait(55)}S.busy.memo=false;paintMemo();await wait(500);continue}
 S.busy[ch]=m.name;paintChat(ch);await wait(700+Math.min(1600,m.text.length*45));S.busy[ch]=null;if(S.gen!==g)return;S.chats[ch].push({name:m.name,text:m.text});paintChat(ch);notifyChat(ch,m);await wait(350)}}
function notifyChat(ch,m){const w=S.wins.find(x=>x.id==='chat_'+ch);if(!w||w.min||topWin()!==w){if(!w)openChat(ch);else{const t=$('.wt',w.el);t.classList.add('blink');setTimeout(()=>t.classList.remove('blink'),3000);nateToast(m.name+' 的消息',m.text.slice(0,30))}}}
async function runBeat(i){const b=D.beats[i];S.beat=i;S.waiting=null;if(!b)return;
 const pre=['ireneOn','group'].includes(b.act);
 if(b.act&&pre)await doAct(b.act);
 const ch=b.ch==='sys'?null:b.ch;
 if(ch==='memo'){openMemo();focusWin('memo')}else if(ch&&ch!=='sys'){openChat(ch);focusWin('chat_'+ch)}
 if(ch&&b.say)await speak(ch,parseSay(b.say));
 if(b.act&&!pre)await doAct(b.act);
 const nx=b.next||'chat';
 if(nx==='none')return;
 if(nx==='auto'){await wait(900);return runBeat(i+1)}
 S.waiting={i,ch,type:nx};
 if(nx==='chat'&&ch){const inp=$(ch==='memo'?'#memoIn':'#ci_'+ch);if(inp)inp.focus({preventScroll:true})}
 // 已满足的条件直接推进
 if(nx==='visit'&&S.ireneVisited)event('visit');if(nx==='signup'&&S.joined)event('signup');}
function event(type){if(S.waiting&&S.waiting.type===type){const i=S.waiting.i;S.waiting=null;setTimeout(()=>runBeat(i+1),900)}}
async function userSend(ch){const inp=$(ch==='memo'?'#memoIn':'#ci_'+ch);if(!inp)return;const v=inp.value.trim();if(!v)return;inp.value='';
 S.chats[ch].push({me:true,text:v});ch==='memo'?paintMemo():paintChat(ch);
 const W=S.waiting;
 if(W&&W.type==='chat'&&W.ch===ch&&!S.replying){const b=D.beats[W.i];S.replying=true;
  const defName=ch==='irene'?NM('j'):NM('w');const rep=ruleReply(v,b.rules,b.def,defName);await wait(500);await speak(ch,rep);S.replying=false;
  if(needOk(v,b.need)&&S.waiting===W){S.waiting=null;await wait(900);runBeat(W.i+1)}return}
