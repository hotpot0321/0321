<!DOCTYPE html>
<html lang="zh-CN"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>ssw的电脑</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/galmuri@2.40.3/dist/galmuri.css">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&amp;family=Noto+Sans+KR:wght@400;500;700&amp;family=Nanum+Gothic+Coding&amp;family=Nanum+Pen+Script&amp;display=swap" rel="stylesheet">
<style>*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;touch-action:manipulation}
html,body{height:100%;overflow:hidden;background:#17140f}
body{font-family:"Noto Sans KR",-apple-system,"Apple SD Gothic Neo",sans-serif;color:#222}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,textarea,select{font:inherit;color:inherit}

/* ---------------- 房间与显示器 ---------------- */
#room{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(70% 60% at 50% 45%,#3a3128,#16120d 75%);transition:opacity .6s}
#room.off{opacity:0;pointer-events:none}
#mon{display:flex;flex-direction:column;align-items:center;transform-origin:50% 50%;flex:none}
#bezel{width:836px;padding:18px 18px 0;background:linear-gradient(#2e2e31,#1d1d20);border-radius:14px;box-shadow:0 30px 60px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.08)}
#scrWrap{width:1024px;height:768px;background:#000;overflow:hidden;position:relative;box-shadow:inset 0 0 0 2px #0b0b0c}
#screen{position:absolute;left:0;top:0;width:1024px;height:768px;overflow:hidden;transform-origin:0 0;background:#000;font-family:"Dotum","돋움","Gulim","Apple SD Gothic Neo","Noto Sans KR",sans-serif;font-size:12px;user-select:none;-webkit-user-select:none;transition:transform .45s cubic-bezier(.3,.8,.3,1)}
#monFoot{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;color:#6d6d72;font-size:11px;letter-spacing:.15em}
#pwr{width:22px;height:22px;border-radius:50%;border:2px solid #4a4a50;position:relative}
#pwr:after{content:'';position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:#3a3a3e}
#pwr.on:after{background:#4dd2ff;box-shadow:0 0 8px #4dd2ff}
#stand{width:200px;height:46px;background:linear-gradient(#232326,#151517);clip-path:polygon(38% 0,62% 0,78% 100%,22% 100%)}
#room.zoom{background:#0d0c0a}
#room.zoom #mon{position:fixed;inset:0;transform:none!important}
#room.zoom #bezel{position:absolute;inset:0;width:auto;padding:0;border-radius:0;background:#0d0c0a;box-shadow:none}
#room.zoom #scrWrap{position:absolute;inset:0;width:auto;height:auto;background:#0d0c0a;box-shadow:none}
#room.zoom #monFoot,#room.zoom #stand{display:none}
#zoomBtn{position:fixed;right:12px;top:calc(10px + env(safe-area-inset-top,0px));z-index:30;padding:7px 12px;border-radius:16px;background:rgba(255,255,255,.16);color:#fff;font-size:12px;font-weight:600;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
#editBtn{position:fixed;left:12px;top:calc(10px + env(safe-area-inset-top,0px));z-index:45;padding:7px 14px;border-radius:16px;background:#fff;color:#111;font-size:12px;font-weight:700}
#zbar{position:fixed;left:0;right:0;bottom:0;z-index:25;display:none;gap:4px;padding:5px 6px calc(5px + env(safe-area-inset-bottom,0px));background:linear-gradient(#3682e5,#245ddb 40%,#1941a5);overflow-x:auto;scrollbar-width:none}
#zbar.on{display:flex}
#zbar button{flex:none;max-width:150px;height:30px;padding:0 10px;border-radius:3px;background:linear-gradient(#3c8af0,#2a6be0);color:#fff;font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-shadow:inset 0 0 0 1px rgba(0,0,0,.2);font-family:"Dotum",sans-serif}
#zbar button.on{background:linear-gradient(#1e4fb8,#1a46a8);box-shadow:inset 0 1px 3px rgba(0,0,0,.4)}
#zbar .zs{background:linear-gradient(#3fae3a,#2f8f2a);font-weight:700;font-style:italic;border-radius:0 12px 12px 0;padding:0 16px}

/* ---------------- 启动画面 ---------------- */
#intro{position:fixed;inset:0;z-index:40;display:none;align-items:center;justify-content:center;background:#100d0a;color:#eadfce;overflow-y:auto;padding:30px 22px}
#intro.on{display:flex}
.ib{max-width:440px;text-align:center;display:flex;flex-direction:column;align-items:center;margin:auto}
.it{font-family:"Gowun Batang",serif;font-size:30px;font-weight:700;letter-spacing:-.5px}
.is{font-size:13px;opacity:.6;margin-top:6px}
.ix{font-family:"Gowun Batang",serif;font-size:15.5px;line-height:2;margin:34px 0 30px;opacity:.88;word-break:keep-all}
.ipw{width:74px;height:74px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#3a3a3e,#1b1b1e);box-shadow:0 0 0 3px #2a2a2e,0 10px 26px rgba(0,0,0,.6),0 0 30px rgba(77,210,255,.15);position:relative;animation:pwrG 2.2s ease-in-out infinite}
.ipw span{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-11px 0 0 -13px;border:3px solid #4dd2ff;border-top-color:transparent;border-radius:50%}
.ipw span:after{content:'';position:absolute;left:50%;top:-9px;width:3px;height:14px;margin-left:-1.5px;background:#4dd2ff;border-radius:2px}
@keyframes pwrG{50%{box-shadow:0 0 0 3px #2a2a2e,0 10px 26px rgba(0,0,0,.6),0 0 44px rgba(77,210,255,.4)}}
.ib small{font-size:12px;opacity:.5;margin-top:12px}
.in{font-size:11px;opacity:.4;margin-top:40px;line-height:1.6}

/* ---------------- 启动 ---------------- */
#screen.black,#screen.boot{background:#000}
.bios{color:#c8c8c8;font-family:"Courier New",monospace;font-size:13px;line-height:1.5;padding:24px}
.xpboot{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#000;color:#fff}
.xl{display:flex;align-items:flex-start;gap:8px;font-family:"Franklin Gothic Medium","Arial",sans-serif}
.xl .f{width:44px;height:40px;display:grid;grid-template-columns:1fr 1fr;gap:3px;transform:perspective(80px) rotateY(-12deg) skewY(-4deg)}
.xl .f i{border-radius:4px 8px 4px 6px}
.xl .f i:nth-child(1){background:#f35325}.xl .f i:nth-child(2){background:#81bc06}.xl .f i:nth-child(3){background:#05a6f0}.xl .f i:nth-child(4){background:#ffba08}
.xl b{font-size:38px;font-weight:600;letter-spacing:-1px;line-height:1}
.xl sup{font-size:20px;color:#f6821f;font-weight:700;font-style:italic}
.xl.small b{font-size:30px}.xl.small .f{width:36px;height:32px}
.xbar{width:150px;height:18px;border:2px solid #b2b2b2;border-radius:5px;margin-top:40px;overflow:hidden;position:relative;padding:2px}
.xbar i{position:absolute;top:2px;width:9px;height:10px;border-radius:1px;background:linear-gradient(#a7c7ff,#2f5fd8 50%,#a7c7ff);animation:xb 1.8s linear infinite}
.xbar i:nth-child(2){animation-delay:.12s}.xbar i:nth-child(3){animation-delay:.24s}
@keyframes xb{from{left:-30px}to{left:160px}}
.xpboot small{position:absolute;bottom:20px;left:20px;font-size:11px;opacity:.6}
.xpwel{position:absolute;inset:0;background:#5a7edc}
.xpwel:before,.xpwel:after{content:'';position:absolute;left:0;right:0;height:70px;background:#00309c}
.xpwel:before{top:0;border-bottom:2px solid #7f9de0}.xpwel:after{bottom:0;border-top:2px solid #f08b2c}
.xpwel .wl{position:absolute;left:0;top:70px;bottom:70px;width:50%;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;padding-right:30px;color:#fff;border-right:1px solid rgba(255,255,255,.5);background:radial-gradient(70% 60% at 20% 20%,rgba(255,255,255,.35),transparent 60%)}
.xpwel .wl p{margin-top:16px;font-size:14px}
.xpwel .wr{position:absolute;left:50%;top:70px;bottom:70px;right:0;display:flex;align-items:center;padding-left:30px;color:#fff}
.xpwel .wr h2{font-size:40px;font-style:italic;font-weight:700;font-family:"Franklin Gothic Medium",Arial,sans-serif;text-shadow:0 2px 3px rgba(0,0,0,.3)}
.usr{display:flex;align-items:center;gap:12px;padding:8px 14px 8px 8px;border-radius:8px;color:#fff;background:linear-gradient(90deg,rgba(0,48,156,.6),transparent);font-size:17px}
.usr .ua{width:52px;height:52px;border-radius:6px;background:#fff8e6;border:2px solid #f6c443;display:flex;align-items:center;justify-content:center;font-size:30px}
.xpwel .wf{position:absolute;left:0;right:0;bottom:0;height:70px;z-index:2;display:flex;align-items:center;padding-left:24px;color:#fff;font-size:13px}
#screen.crtOff{animation:crt 1.45s ease-in forwards}
@keyframes crt{40%{transform:scale(1,.004);filter:brightness(4)}100%{transform:scale(0,.004);filter:brightness(6)}}

/* ---------------- 桌面 ---------------- */
.wall{position:absolute;inset:0;background:radial-gradient(160% 70% at 30% 115%,#5aa63c 40%,#3d8a2c 52%,transparent 52.5%),radial-gradient(140% 60% at 85% 120%,#6bb44a 42%,transparent 42.5%),linear-gradient(#1f62d8,#5d9cf0 45%,#bcd8f6 70%,#e4eefb)}
.wall:after{content:'';position:absolute;left:12%;top:16%;width:160px;height:50px;border-radius:50px;background:rgba(255,255,255,.75);filter:blur(10px);box-shadow:330px 40px 0 -6px rgba(255,255,255,.6)}
.icons{position:absolute;left:8px;top:10px;display:flex;flex-direction:column;gap:6px;z-index:1}
.dico{width:84px;display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px 2px;border-radius:3px;color:#fff;text-shadow:1px 1px 1px #000;font-size:12px}
.dico span{font-size:32px;line-height:1;filter:drop-shadow(1px 2px 1px rgba(0,0,0,.35))}
.dico b{font-weight:400;line-height:1.25;word-break:keep-all;text-align:center;padding:0 2px}
.dico:active b{background:#316ac5}
.dico.glow span{animation:gl 1.2s ease-in-out infinite}
@keyframes gl{50%{filter:drop-shadow(0 0 10px #fff) brightness(1.3)}}
#wins{position:absolute;inset:0 0 30px 0}
.tbar{position:absolute;left:0;right:0;bottom:0;height:30px;display:flex;align-items:center;z-index:900;background:linear-gradient(#1f2f86 0,#3165c4 3%,#3682e5 6%,#4490e6 10%,#3883e5 12%,#2b71e0 15%,#2663da 18%,#235bd6 20%,#2258d5 23%,#2157d6 38%,#245ddb 54%,#2562df 86%,#245fdc 89%,#2158d4 92%,#1d4ec0 95%,#1941a5 98%)}
.start{height:30px;padding:0 22px 0 10px;display:flex;align-items:center;gap:6px;color:#fff;font-size:16px;font-weight:700;font-style:italic;text-shadow:1px 1px 1px rgba(0,0,0,.4);border-radius:0 12px 12px 0;background:linear-gradient(#3c9b39,#5ec359 12%,#40a53b 40%,#2f8f2a 90%,#2a7f25);box-shadow:inset -2px 0 3px rgba(0,0,0,.25)}
.start i{font-style:normal;font-size:15px}
#tbWins{flex:1;display:flex;gap:3px;padding:0 6px;min-width:0}
#tbWins button{flex:0 1 150px;min-width:0;height:24px;padding:0 8px;display:flex;align-items:center;gap:5px;border-radius:3px;background:linear-gradient(#3c8af0,#2a6be0);color:#fff;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-shadow:inset 0 0 0 1px rgba(0,0,30,.25)}
#tbWins button.on{background:linear-gradient(#1e4fb8,#1a46a8);box-shadow:inset 1px 1px 3px rgba(0,0,0,.45)}
.tray{height:30px;display:flex;align-items:center;gap:8px;padding:0 12px;color:#fff;font-size:11.5px;background:linear-gradient(#0c59b9,#139ee9 6%,#18b5f2 10%,#139beb 14%,#1290e8 19%,#0d8dea 63%,#0d9ff1 81%,#0f9eed 88%,#119be9 91%,#1392e2 94%,#137ed7 97%,#095bc9);border-left:1px solid #092e6e}
#balloon{position:absolute;right:8px;bottom:40px;z-index:950;width:240px;padding:10px 12px;border-radius:8px;background:#ffffe1;border:1px solid #000;box-shadow:2px 2px 4px rgba(0,0,0,.3);display:none;font-size:12px}
#balloon.on{display:block;animation:pop .3s ease}
#balloon:after{content:'';position:absolute;right:30px;bottom:-12px;border:6px solid transparent;border-top-color:#ffffe1;border-left-color:#ffffe1}
#balloon i{position:absolute;right:8px;top:6px;font-style:normal;cursor:pointer;color:#666}
#balloon b{display:block;margin-bottom:4px}
@keyframes pop{from{opacity:0;transform:translateY(6px)}}

/* ---------------- 窗口 ---------------- */
.win{position:absolute;display:flex;flex-direction:column;border:1px solid #0046d5;border-radius:8px 8px 0 0;box-shadow:2px 3px 10px rgba(0,0,0,.45);overflow:hidden;padding:0 3px 3px;background:linear-gradient(#0058ee,#0054e3)}
.wt{height:29px;flex:none;display:flex;align-items:center;gap:5px;color:#fff;font-weight:700;font-size:12.5px;text-shadow:1px 1px 1px #0f1089;background:linear-gradient(#0997ff,#0053ee 8%,#0050ee 40%,#06f 88%,#06f 93%,#005bff 95%,#003dd7 96%,#003dd7);margin:0 -3px;padding:0 2px 0 8px;cursor:default;font-family:"Trebuchet MS","Dotum",sans-serif}
.wt b{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wt .wi{font-size:13px}
.wt.blink{animation:wtb .5s steps(1) 6}
@keyframes wtb{50%{background:linear-gradient(#ffb65c,#f08a12)}}
.wb{display:flex;gap:2px;padding-right:4px}
.wb i{width:21px;height:21px;border-radius:3px;border:1px solid #fff;background:linear-gradient(135deg,#3d95ff,#0b5ae8);font-style:normal;font-size:11px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;text-shadow:none}
.wb i.x{background:linear-gradient(135deg,#e8775a,#c33d1b)}
.wc{flex:1;min-height:0;background:#ece9d8;display:flex;flex-direction:column;overflow:hidden}
.xpdlg{position:absolute;inset:0;z-index:2000;background:rgba(0,0,0,.08)}
.xpdlg .dlg{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:320px}
.xpdlg .dlg .wc{padding:14px 14px 12px}
.dm{display:flex;gap:12px;align-items:flex-start}
.di{font-size:28px;line-height:1}
.dm p{font-size:12.5px;line-height:1.6;word-break:keep-all}
.db{display:flex;justify-content:center;gap:8px;margin-top:14px}
.db button,.jb,.gbI button,.npIn button,.ncIn button{min-width:76px;height:24px;padding:0 10px;border:1px solid #003c74;border-radius:3px;background:linear-gradient(#fff,#ece9d8 85%,#d8d2bd);font-size:12px;color:#000}
.dinp{display:block;width:100%;margin-top:10px;height:26px;border:1px solid #7f9db9;padding:0 6px;background:#fff;font-size:16px;user-select:text;-webkit-user-select:text}
.ntoast{position:absolute;right:10px;bottom:38px;z-index:1500;width:200px;background:linear-gradient(#fff,#eaf3ff);border:1px solid #6b8fd6;border-radius:4px;box-shadow:2px 2px 6px rgba(0,0,0,.3);padding:0 0 10px;transform:translateY(140%);transition:transform .45s ease;overflow:hidden;font-family:"Dotum",sans-serif}
.ntoast.on{transform:none}
.ntoast .nh{background:linear-gradient(#5fa0f0,#2f6fd8);color:#fff;font-size:10px;font-weight:700;padding:3px 8px;letter-spacing:.1em;margin-bottom:8px}
.ntoast b,.ntoast span{display:block;padding:0 10px;font-size:12px}
.ntoast span{color:#555;margin-top:3px}
.ntoast.zt{position:fixed;right:12px;bottom:auto;top:calc(50px + env(safe-area-inset-top,0px));z-index:60;transform:translateY(-20px);opacity:0;transition:.4s}
.ntoast.zt.on{transform:none;opacity:1}
.stoast{position:absolute;left:50%;top:40%;transform:translate(-50%,10px);z-index:2100;background:rgba(0,0,0,.8);color:#fff;font-size:13px;padding:10px 16px;border-radius:6px;opacity:0;transition:.3s;font-family:"Noto Sans KR",sans-serif;max-width:90%;text-align:center}
.stoast.on{opacity:1;transform:translate(-50%,0)}
.stoast.zt{position:fixed;z-index:60}
.exp{flex:1;display:flex;font-size:12px;background:#fff}
.eside{width:120px;background:linear-gradient(#7ba2e7,#6375d6);padding:10px;color:#fff;display:flex;flex-direction:column;gap:6px}
.emain{flex:1;padding:10px;display:flex;flex-direction:column;gap:6px}
.emain.grid{flex-direction:row;flex-wrap:wrap;align-content:flex-start}
.emain.grid .ei{width:46%}
.eh{font-weight:700;border-bottom:1px solid #6375d6;color:#1f3c8b;padding-bottom:2px}
.ei small{display:block;color:#777;font-size:11px}
.npm{display:flex;gap:10px;padding:3px 6px;background:#ece9d8;border-bottom:1px solid #aca899;font-size:12px}
.npb{flex:1;overflow-y:auto;padding:4px 6px;background:#fff;font-family:"Gulimche","굴림체","Nanum Gothic Coding",monospace;font-size:13px;line-height:1.55;user-select:text;-webkit-user-select:text;white-space:pre-wrap;word-break:break-all}
.npb .cur{display:inline-block;width:1px;height:14px;background:#000;vertical-align:-2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.npIn{display:flex;gap:4px;padding:4px;background:#ece9d8;border-top:1px solid #aca899}
.npIn input{flex:1;min-width:0;height:26px;border:1px solid #7f9db9;padding:0 6px;font-family:"Gulimche","굴림체","Nanum Gothic Coding",monospace;font-size:16px;background:#fff;user-select:text;-webkit-user-select:text}
.npIn button{height:26px}

/* ---------------- IE · Cyworld ---------------- */
.ieTool{display:flex;gap:10px;padding:2px 6px;font-size:11.5px;border-bottom:1px solid #d6d2c2}
.ieAddr{display:flex;align-items:center;gap:6px;padding:3px 6px;font-size:11.5px;border-bottom:1px solid #aca899}
.ieAddr .ad{flex:1;min-width:0;height:20px;border:1px solid #7f9db9;background:#fff;padding:0 6px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;font-size:11.5px}
.ieAddr .go{color:#1f3c8b}
.cy{flex:1;min-height:0;display:flex;flex-direction:column;padding:8px 10px 10px;background:#c9d6e3 radial-gradient(rgba(255,255,255,.6) 1px,transparent 1.5px) 0 0/8px 8px}
.cy.j{background-color:#ead9e4}
.cyTop{display:flex;align-items:center;gap:8px;padding:0 4px 5px;font-size:11px;color:#555}
.cyTop .cnt{white-space:nowrap}.cyTop .cnt b{color:#ff3a00}
.cyTop .cyT{flex:1;min-width:0;text-align:center;font-weight:700;font-size:13px;color:#2a5fa3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cy.j .cyTop .cyT{color:#b04a7a}
.cyTop .bgm{font-size:10.5px;color:#2a5fa3;background:#fff;border:1px solid #9fb6cf;border-radius:10px;padding:1px 8px;max-width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cyTop .bgm i{font-style:normal;color:#ff7a00}
.cyBody{flex:1;min-height:0;display:flex;gap:6px}
.cyL{width:140px;flex:none;background:#fff;border:1px solid #a9b9cc;border-radius:8px;padding:8px;display:flex;flex-direction:column;gap:6px;overflow:hidden}
.cyL .ph{aspect-ratio:1;border:1px solid #ccd;background:#eef2f7 center/cover;position:relative;flex:none}
.cyL .ph i{position:absolute;left:50%;bottom:12%;width:44%;height:56%;margin-left:-22%;border-radius:40% 40% 30% 30%;background:#f6d4bd;box-shadow:0 -18px 0 -3px #3d2e26}
.cyL .md{font-size:10.5px;color:#888}.cyL .md b{color:#ff6c00}
.cyL .it{font-size:11.5px;line-height:1.5;color:#444;flex:1;overflow:hidden;word-break:keep-all}
.cyL .pf{font-size:11px;color:#2a5fa3;border-top:1px dotted #bbb;padding-top:4px}
.wave{width:100%;height:22px;font-size:11px;border:1px solid #9fb6cf;background:#f5f8fc;flex:none}
.cyR{flex:1;min-width:0;display:flex}
.cyMain{flex:1;min-width:0;background:#fff;border:1px solid #a9b9cc;border-radius:8px 0 8px 8px;padding:8px 10px;overflow-y:auto}
.cyTabs{width:42px;flex:none;display:flex;flex-direction:column;gap:2px;padding-top:10px}
.cyTabs button{height:30px;border-radius:0 6px 6px 0;background:#3b6cb5;color:#fff;font-size:11px;letter-spacing:-.6px;border:1px solid #2f5a99;border-left:0}
.cy.j .cyTabs button{background:#c0679a;border-color:#a2547f}
.cyTabs button.on{background:#fff;color:#2a5fa3;font-weight:700;margin-left:-1px;border-color:#a9b9cc}
.cy.j .cyTabs button.on{color:#b04a7a}
.cyNews b,.cyIl>b{display:block;font-size:11.5px;color:#ff6c00;border-bottom:1px solid #eee;padding-bottom:2px;margin-bottom:4px}
.cyNews ul,.cyIl ul{list-style:none;font-size:11.5px;line-height:1.75}
