 if(b&&C.includes(b.ch)&&C.includes(S.lastCh)&&b.ch!==S.lastCh&&!S.ended){await wait(3000);if((S.gen||0)!==g)return}
 if((S.gen||0)!==g)return;
 if(b&&b.ch&&b.ch!=='day'&&b.ch!=='narr')S.lastCh=b.ch;return _runBeat5(i)};

