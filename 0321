//  彩蛋
// =====================================================================
function EG(){return D.eggs||{}}
// ① 2019 回收站 文件 还原
ACT.eggTrash=async()=>{seeTrace();const r=await xpAlert(`‘${EG().trashName||'想对艺琳说的话.txt'}’\n\n是否还原此文件？`,[['还原','ok'],['取消','x']],'🗑️');if(r!=='ok')return;
 openWin('eggtrash',{title:(EG().trashName||'文件')+' - 记事本',icon:'📝',x:270,y:110,w:340,h:300,cls:'np',render:c=>{c.innerHTML=`<div class="npm"><span>文件(F)</span><span>编辑(E)</span><span>格式(O)</span><span>查看(V)</span><span>帮助(H)</span></div><div class="npb">${br(EG().trashTxt||'')}</div>`}});focusWin('eggtrash')};
// ② 2009年自由模式晚上十点整由胜完主动发起对话
async function eggTen(){if(S._tenDone||S.era!=='2009'||!S.free)return;S._tenDone=true;await wait(800);openChat('nate');focusWin('chat_nate');
 for(const m of parseSay(EG().tenLines||'')){if(S.era!=='2009')return;S.busy.nate=m.name;paintChat('nate');await wait(900+Math.min(1400,m.text.length*45));S.busy.nate=null;S.chats.nate.push({name:m.name,text:m.text});paintChat('nate');await wait(300)}}
function eggTick(){if(S.era==='2009'&&S.free&&!S._tenDone&&/下午 10:00/.test(timeStr()))eggTen()}
setInterval(eggTick,2000);
ACT.clock=async()=>{if(S.phase!=='desk')return;const v=await xpPrompt(`日期和时间属性\n\n可以修改时间（例如：22:00）`);if(v==null)return;if(S.era==='2019'&&String(v).trim()===String(EG().code||'0221')){eggFlash();return}const m=String(v).trim().match(/^(\d{1,2})\s*[:시]\s*(\d{1,2})?/);if(!m){xpAlert('时间格式不正确。');return}
 const hh=Math.min(23,+m[1]),mm=Math.min(59,+(m[2]||0));S.pcTime=`${pad(hh)}:${pad(mm)}`;S.t0=Date.now();tick();eggTick()};
// ③ 2019年多次点击 NateOn 后出现未读私信
function eggNote(){seeTrace();openWin('eggnote',{title:'NateOn 收件箱 - 1封未读私信',icon:'✉️',x:300,y:130,w:330,h:280,render:c=>{c.innerHTML=`<div class="eNote"><div class="enH">✉️ 未读私信 <b>1</b>封</div><div class="enB">${br(EG().nateNote||'')}</div><div class="db"><button data-act="wClose:eggnote">关闭</button></div></div>`}});focusWin('eggnote')}
// ④ 无法撤销的还原点
ACT.eggRestore=()=>xpAlert(EG().restoreMsg||'',[['确定','x']],'⏪');
// ⑤ 点击胜完迷你小屋的电脑后映出当前画面
ACT.eggMirror=()=>{const scr=$('#screen');const clone=scr.cloneNode(true);clone.removeAttribute('id');clone.querySelectorAll('[id]').forEach(e=>e.removeAttribute('id'));
 openWin('eggmirror',{title:'...?',icon:'🖥️',x:340,y:150,w:300,h:270,render:c=>{c.innerHTML=`<div class="eMir"><div class="emS"></div><p>${esc(EG().mirror||'')}</p></div>`;const box=$('.emS',c);clone.style.cssText='position:absolute;left:0;top:0;width:1024px;height:768px;transform:scale(.26);transform-origin:0 0;pointer-events:none';box.appendChild(clone)}});focusWin('eggmirror')};
// ⑥ 在2019年桌面输入0221
let _eggBuf='';document.addEventListener('keydown',e=>{const t=e.target;if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'))return;if(S.era!=='2019'||S.phase!=='desk')return;
 if(e.key&&e.key.length===1){_eggBuf=(_eggBuf+e.key).slice(-12);const code=String(EG().code||'0221');if(code&&_eggBuf.endsWith(code)){_eggBuf='';eggFlash()}}});
async function eggFlash(){const scr=$('#screen');if(scr.classList.contains('flash09'))return;scr.classList.add('flash09');balloon(EG().codeMsg||'');await wait(3800);scr.classList.remove('flash09')}
// ⑦ 2019年连续点击互联网三次后显示未来新闻
async function eggIE(){S.ieTries=(S.ieTries||0)+1;const need=Number(EG().ieClicks)||3;
 if(S.ieTries<need)return openDead();S.ieTries=0;const w=S.wins.find(x=>x.id==='ie');if(w)closeWin('ie');
 openNews(true)}
function openNews(scare){const e=EG();openWin('ienews',{title:(e.newsTitle||'')+' - Microsoft Internet Explorer',icon:'🌐',x:120,y:30,w:640,h:520,cls:'ie',render:c=>{c.innerHTML=`<div class="ieTool"><span>文件(F)</span><span>编辑(E)</span><span>查看(V)</span><span>收藏夹(A)</span><span>工具(T)</span></div><div class="ieAddr"><span>地址(D)</span><div class="ad">http://news.???.com/article/20261100001</div><span class="go">➡ 转到</span></div><div class="ieBody news"><div class="nwBan">${esc(e.newsBanner||'')}</div><article><div class="nwSrc">${esc(e.newsSrc||'')} · ${esc(e.newsDate||'')}</div><h1>${esc(e.newsTitle||'')}</h1><p>${br(e.newsBody||'')}</p></article>${scare?'<div class="nwErr"><pre></pre></div>':''}</div>`}});focusWin('ienews');if(scare)newsScare()}

// ----- 艺琳的主页 头像 (从编辑器预设的照片中选择) -----
function yPhotoIdx(){const Y=D.yHome||{},P=Y.photos||[];if(S.yPhoto!=null&&P[S.yPhoto]&&P[S.yPhoto].src)return S.yPhoto;const d=Number(Y.def)||0;if(P[d]&&P[d].src)return d;return P.findIndex(p=>p&&p.src)}
function yPhotoSrc(){const i=yPhotoIdx();const P=(D.yHome||{}).photos||[];return i>=0&&P[i]?P[i].src:''}
ACT.yPhoto=i=>{S.yPhoto=+i;rerenderIE();toastText('头像已更换')};

// ----- 填充剧情痕迹 (编辑器模式或跳转场景时) -----
function wGuestDate(){const i=D.beats.findIndex(b=>b.act==='wGuest');let d=S.pcDate;for(let k=i;k>=0;k--){if(D.beats[k].ch==='day'){d=D.beats[k].pc;break}}if(i>=0&&!D.beats.slice(0,i).some(b=>b.ch==='day'))d=D.pc.date;return String(d||'2009-08-30').replace(/-/g,'.')}
function ensureTraces(full){S.gb.y=S.gb.y||[];
 const passedGuest=full||D.beats.slice(0,Math.max(0,S.beat)).some(b=>b.act==='wGuest');
 if(passedGuest&&D.wGuestText&&!S.gb.y.some(e=>e.n===NM('w')))S.gb.y.push({n:NM('w'),d:wGuestDate(),t:D.wGuestText});
 if(full){S.ilWrite=S.ilWrite||{};if(!S.ilWrite.y)S.ilWrite.y='相差十年的亲密好友 哈哈哈'}}
function sampleDeco(){const it=shopItems();const pick=k=>it.filter(x=>x.kind===k);const e=S.eq;
 if(e.wall||e.floor||e.items.length||e.outfit)return;
 const w=pick('壁纸')[0],f=pick('地板')[0],fu=pick('家具').slice(0,2),o=pick('迷你人偶')[0];
 [w,f,o,...fu].filter(Boolean).forEach(x=>{if(!S.owned.includes(x.i))S.owned.push(x.i)});
 if(w)e.wall=w.val;if(f)e.floor=f.val;if(o)e.outfit=o.val;e.items=fu.map(x=>x.val)}

// ----- 珠泫秘密文件夹：告白场景结束后解锁 -----
function secretReady(){if(S.free||S.ended||S.era==='2019')return true;const pi=D.beats.findIndex(b=>b.ch==='peek');if(pi<0)return true;return S.beat>pi}
// ----- 结局后：浏览胜完留下的痕迹后强调降级 -----
function seeTrace(){if(S.era!=='2019'||!S.post19)return;S.traceSeen=(S.traceSeen||0)+1;if(S.traceSeen>=2)setTimeout(glowRestore,2500)}
function glowRestore(){if(S.era!=='2019'||S._dgGlow)return;const n=$$('.dico').find(x=>x.dataset.act==='ico:restore');if(n){S._dgGlow=true;n.classList.add('glow')}}

// 十点彩蛋 回复: 每行只使用一次，全部用完后返回 null (→ 退出登录)
function tenReply(v,name){const E=EG();S.tenUsed=S.tenUsed||{};const q=normQ(v);let i=0;
 for(const l of lines(E.tenRules||'')){const [k,...rest]=l.split('=>');if(rest.length&&!S.tenUsed['r'+i]&&keyList(k).some(x=>q.includes(x))){S.tenUsed['r'+i]=1;return splitSay(rest.join('=>'),name)}i++}
 if(String(E.tenDef||'').trim()&&!S.tenUsed.def){S.tenUsed.def=1;return splitSay(E.tenDef,name)}
 return null}

async function newsScare(){const box=$('.nwErr');if(!box)return;const pre=$('pre',box);const L=lines(EG().newsErr||'');
 for(const l of L){if(!$('.nwErr'))return;pre.textContent+=l+'\n';box.classList.add('jit');await wait(140);box.classList.remove('jit');await wait(380)}
 await wait(500);box.classList.add('out');await wait(700);box.remove()}

