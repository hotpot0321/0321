 S.gen=(S.gen||0)+1;S.ended=true;clearTimeout(S._auto);clearTimeout(S._st);S.waiting=null;S.offWait=null;S.bsodWait=null;
 const ob=$('#offBar');if(ob)ob.remove();const z=$('#zPwr');if(z)z.classList.remove('on');document.body.classList.remove('bsOn');$('#pwr').classList.remove('blinkPwr');
 $('#intro').classList.remove('on');$('#room').classList.remove('off');$('#narr').classList.remove('on');
 if(!S.me||!S.me.nick)S.me={id:'yerim04',nick:(D.nicks&&D.nicks.y)||'艺琳',pw:''};
 S.storyStarted=true;S.hompyAt=S.hompyAt||Date.now();S.ilchon=S.ilchon||{mine:'过去的姐姐',yours:'未来的小不点'};S.ireneFriend=true;S.wDiary=true;S.wDiaryRead=true;S.skipped=true;
 freeMode('2009')}


